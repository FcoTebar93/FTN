{
    "name": "ftn-dsl-project",
    "version": "0.1.0",
    "description": "Deterministic workflow engine in TypeScript with event sourcing, snapshots, workers, and optional Postgres/Redis backends.",
    "author": "Francisco Tébar Navarro",
    "license": "MIT",
    "engines": {
        "node": ">=20.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^22.19.13",
        "eslint": "^10.1.0",
        "nodemon": "^3.1.9",
        "pg": "^8.14.1",
        "ts-node": "^10.9.2",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.7.3",
        "typescript-eslint": "^8.57.2"
    },
    "scripts": {
        "build": "tsc",
        "test": "npm run build && node --test dist/__tests__/*.test.js",
        "check:openapi": "node scripts/check-openapi.mjs",
        "demo:smoke": "node --env-file=.env scripts/demo-smoke-hybrid.mjs",
        "start": "node --env-file=.env dist/infra/main.js",
        "test:integration": "npm run build && node --test dist/__tests__/integration/postgres-persistence.test.js dist/__tests__/integration/users.test.js dist/__tests__/integration/workflow-runtime-postgres.test.js dist/__tests__/integration/postgres-concurrency.test.js dist/__tests__/integration/redis-task-queue.test.js",
        "lint": "eslint src"
    },
    "dependencies": {
        "@opentelemetry/api": "^1.9.0",
        "@opentelemetry/resources": "^1.30.1",
        "@opentelemetry/sdk-trace-node": "^1.30.1",
        "@sendgrid/mail": "^8.1.6",
        "googleapis": "^148.0.0",
        "ioredis": "^5.10.1",
        "nodemailer": "^8.0.2",
        "pg": "^8.14.1",
        "qrcode": "^1.5.4",
        "stripe": "^18.3.0"
    }
}
